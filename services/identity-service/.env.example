# GoAuth identity service environment template.
# Full matrix: ../../docs/configuration.md
# Values marked as secrets in the matrix must not be committed with real values.

# Core
APP_ENV=development
HTTP_ADDR=:8080
PUBLIC_ISSUER_URL=
BROWSER_LOGIN_URL=/login
BROWSER_COOKIE_SECURE=

# Storage and signing
MYSQL_DSN=
REDIS_URL=
AVATAR_STORAGE_DIR=data/avatars
JWT_PRIVATE_KEY_PATH=
JWT_KEY_ID=
JWT_KEYSET_DIR=
JWT_ACTIVE_KEY_ID=
ACCESS_TOKEN_TTL=15m
BROWSER_SESSION_TTL=12h
REFRESH_TOKEN_TTL=720h

# Network
TRUSTED_PROXIES=
CORS_ALLOWED_ORIGINS=
CORS_ALLOWED_METHODS=GET,POST,PUT,PATCH,DELETE
CORS_ALLOWED_HEADERS=Authorization,Content-Type,X-Captcha-Token
CORS_ALLOW_CREDENTIALS=

# Mailer
MAILER_PROVIDER=console
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_SSL=false
SMTP_AUTH_LOGIN=false

# Auth entry
REGISTRATION_MODE=open
LOCAL_PASSWORD_LOGIN_ENABLED=true

# Branding
BRAND_NAME=GoAuth
BRAND_TAGLINE=
BRAND_ICON_TEXT=G
BRAND_ICON_URL=

# External login
GITHUB_OAUTH_ENABLED=false
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_REDIRECT_URI=

# Default membership and bootstrap admin
DEFAULT_MEMBER_TENANT_SLUGS=
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_PASSWORD=
BOOTSTRAP_ADMIN_USERNAME=
BOOTSTRAP_ADMIN_NICKNAME=
BOOTSTRAP_ADMIN_DISPLAY_NAME=
BOOTSTRAP_ADMIN_ROLE=root

# Account lockout
LOCKOUT_THRESHOLD=5
LOCKOUT_DURATION=15m

# Observability
METRICS_ENABLED=true

# Password policy
PASSWORD_MIN_LENGTH=8
PASSWORD_REQUIRE_UPPERCASE=false
PASSWORD_REQUIRE_LOWERCASE=false
PASSWORD_REQUIRE_DIGIT=true
PASSWORD_REQUIRE_SPECIAL=false
PASSWORD_HISTORY_COUNT=3

# Email i18n
DEFAULT_LOCALE=en

# CAPTCHA (leave CAPTCHA_PROVIDER empty to disable)
CAPTCHA_PROVIDER=
CAPTCHA_SECRET_KEY=
CAPTCHA_SITE_KEY=
CAPTCHA_ACTIONS=login,register,email_code,password_forgot
